generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum Role {
  USER
  ADMIN
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Agent {
  id                     String     @id @default(uuid())
  name                   String
  slug                   String     @unique
  description            String?
  systemPrompt           String     @db.Text
  visionPromptInstruction String?   @db.Text
  isActive               Boolean    @default(true)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  documents              Document[]
  images                 Image[]

  @@map("agents")
}

model Document {
  id          String         @id @default(uuid())
  agentId     String
  agent       Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title       String
  filename    String
  mimeType    String
  minioKey    String
  size        Int
  status      DocumentStatus @default(PENDING)
  chunkCount  Int?
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  processedAt DateTime?

  @@index([agentId])
  @@index([status])
  @@map("documents")
}

model Image {
  id          String         @id @default(uuid())
  agentId     String
  agent       Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  minioKey    String
  size        Int
  description Json?
  status      DocumentStatus @default(PENDING)
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  processedAt DateTime?

  @@index([agentId])
  @@index([status])
  @@map("images")
}
